<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Levhrium</AssemblyName>
    <RootNamespace>Levhrium.App</RootNamespace>
    <!-- Navegador roda 64-bit; nao mexe no caminho de saida. -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Levhrium.Core\Levhrium.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Levhrium.E2E.Tests" />
  </ItemGroup>
  <!-- O pacote WebView2 referencia tambem a DLL do WPF, que puxa WindowsBase 5.0 e
       gera MSB3277 num app que nao usa WPF. Como usamos so o controle WinForms,
       tiramos a referencia: o aviso sumindo mantem o build limpo para avisos reais. -->
  <Target Name="DropWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="%(Reference.Identity)"
                 Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
